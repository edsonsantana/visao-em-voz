# Configuração do Google Gemini API (Google AI Studio)
GEMINI_API_KEY=sua_chave_api_aqui

# Porta do Servidor Node
# O Railway atribui PORT automaticamente — defina aqui apenas para dev local
PORT=3005

# ── Banco de Dados ─────────────────────────────────────────────────────────────
# PRODUÇÃO (Railway): o Postgres do Railway fornece DATABASE_URL automaticamente.
# Quando DATABASE_URL estiver definida, as variáveis DB_* abaixo são ignoradas.
# DATABASE_URL=postgres://usuario:senha@host:porta/banco

# DESENVOLVIMENTO LOCAL (Docker Compose): use as variáveis separadas abaixo.
DB_USER=postgres
DB_HOST=localhost
DB_NAME=visao_em_voz
DB_PASSWORD=password
DB_PORT=5432

# ── CORS ───────────────────────────────────────────────────────────────────────
# PRODUÇÃO (Railway): defina com a URL do seu app mobile/web para restringir o CORS.
# Se não definida, o CORS fica liberado (comportamento de desenvolvimento).
# ALLOWED_ORIGIN=https://seu-app.railway.app
